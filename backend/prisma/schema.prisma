generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RaceResult {
  id           Int      @id @default(autoincrement())
  competition  String
  discipline   String
  distance     Int
  athleteName  String
  time         Float
}

model RelayResult {
  id            Int      @id @default(autoincrement())
  competition   String
  relayName     String
  totalTime     Float
  athleteNames  String
}